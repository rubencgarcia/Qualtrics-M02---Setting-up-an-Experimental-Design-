ettings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Answers":{"1":{"Display":"1 - A lot"},"2":{"Display":"2"},"3":{"Display":"3"},"4":{"Display":"4"},"5":{"Display":"5 - Not at all"}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"Please indicate the extent to which you would rely on the following to get recommendations from to purchase a product?"}},{"SurveyID":"SV_9EMz4vUv85Ya5cF","Element":"SQ","PrimaryAttribute":"QID9","SecondaryAttribute":"Please indicate the likelihood that you will trust the following source's information.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please indicate the likelihood that you will trust the following source's information.","DefaultChoices":false,"DataExportTag":"Q4.3","QuestionID":"QID9","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Please indicate the likelihood that you will trust the following source's information.","Choices":{"1":{"Display":"Stranger"},"2":{"Display":"Friends"},"3":{"Display":"Family"},"4":{"Display":"Online Opinion Leaders"},"5":{"Display":"Celebritries"},"6":{"Display":"Co-workers"},"7":{"Display":"Online users"},"8":{"Display":"Small Company "},"9":{"Display":"Large Company"}},"ChoiceOrder":[1,2,3,4,5,6,7,8,9],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Answers":{"1":{"Display":"1-Very likely"},"2":{"Display":"2-Likely"},"3":{"Display":"3-Neutral"},"4":{"Display":"4-Somewhat unlikely"},"5":{"Display":"5-Very unlikely"}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"Please indicate the likelihood that you will trust the following source's information."}},{"SurveyID":"SV_9EMz4vUv85Ya5cF","Element":"SQ","PrimaryAttribute":"QID11","SecondaryAttribute":"Please indicate the likelihood that you would purchase a product\/service within one week after he...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please indicate the likelihood that you would purchase a product\/service within one week after hearing about it through the following channels.<div><br><\/div>","DefaultChoices":false,"DataExportTag":"Q3.2","QuestionID":"QID11","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Please indicate the likelihood that you would purchase a product\/service within one week after he...","Choices":{"1":{"Display":"Strangers"},"2":{"Display":"Friends"},"3":{"Display":"Family"},"4":{"Display":"Online Opinion Leaders"},"5":{"Display":"Celebritries"},"6":{"Display":"Co-workers"},"7":{"Display":"Online users"},"8":{"Display":"Small Company "},"9":{"Display":"Large Company"}},"ChoiceOrder":[1,2,3,4,5,6,7,8,9],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Answers":{"1":{"Display":"1-Very likely"},"2":{"Display":"2-likely"},"3":{"Display":"3-Neutral"},"4":{"Display":"4-Unlikely"},"5":{"Display":"5-Very unlikely"}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"Please indicate the likelihood that you would purchase a product\/service within one week after hearing about it through the following channels.<div><br><\/div>"}},{"SurveyID":"SV_9EMz4vUv85Ya5cF","Element":"SQ","PrimaryAttribute":"QID12","SecondaryAttribute":"Please indicate the time frame of which you would make purchase after hearing about it through tr...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please indicate the time frame of which you would make purchase after hearing about it through traditional advertising (TV, radio, print, billboard)","DataExportTag":"Q8.2","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please indicate the time frame of which you would make purchase after hearing about it through tr...","Choices":{"1":{"Display":"1-Within 24 hours"},"2":{"Display":"2-Within 48 hours"},"3":{"Display":"3-Within a week"},"4":{"Display":"4-Within a month"},"5":{"Display":"5-Within 3 months"},"6":{"Display":"6-Within a year"}},"ChoiceOrder":[1,2,3,4,5,6],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID12","GradingData":[],"QuestionText_Unsafe":"Please indicate the time frame of which you would make purchase after hearing about it through traditional advertising (TV, radio, print, billboard)"}},{"SurveyID":"SV_9EMz4vUv85Ya5cF","Element":"SQ","PrimaryAttribute":"QID15","SecondaryAttribute":"Please rate the level of influence the following sources have on you. ","TertiaryAttribute":null,"Payload":{"QuestionText":"Please rate the level of influence the following sources have on you.&nbsp;","DefaultChoices":false,"DataExportTag":"Q3.4","QuestionID":"QID15","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"Please rate the level of influence the following sources have on you. ","Choices":{"1":{"Display":"Strangers"},"2":{"Display":"Friends"},"3":{"Display":"Family"},"4":{"Display":"Online Opinion Leaders"},"5":{"Display":"Celebritries"},"6":{"Display":"Co-workers"},"7":{"Display":"Online users"},"8":{"Display":"Small companies\u2019 representatives"},"9":{"Display":"Large companies\u2019 representatives"}},"ChoiceOrder":[1,2,3,4,5,6,7,8,9],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"Answers":{"1":{"Display":"1 \u2013 not at all influential "},"2":{"Display":"2 \u2013 slightly influential "},"3":{"Display":"3 \u2013 somewhat influential "},"4":{"Display":"4 \u2013 very influential "},"5":{"Display":"5 \u2013 extremely influential "}},"AnswerOrder":[1,2,3,4,5],"ChoiceDataExportTags":false,"QuestionText_Unsafe":"Please rate the level of influence the following sources have on you.&nbsp;"}},{"SurveyID":"SV_9EMz4vUv85Ya5cF","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"Study of Social Media Opinion Leader's Influence Dear Survey Participant, \u00a0 We are currently enro..","TertiaryAttribute":null,"Payload":{"QuestionText":"<p style=\"text-align: center;\"><span style=\"font-size: 16px;\"><strong>Study of Social Media Opinion Leader's Influence<\/strong><\/span><\/p><p style=\"text-align: center;\"><span style=\"font-size: 16px;\"><strong><br><\/strong><\/span><\/p>\n\n<p><span style=\"color: rgb(0, 0, 0); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;\">Dear Survey Participant, <\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"color: rgb(0, 0, 0); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;\">We are currently enrolled in the Market Research class at Cal Poly Pomona, and are conducting a research study as a part of our class requirement. <\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"color: rgb(34, 34, 34); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\">The purpose of the research is to understand how much of an impact opinion leaders on social media have on a consumer\u2019s purchase decisions. We want to hear your thoughts and opinions on this topic. The entire survey should take approximately 20 minutes of your time. This survey <\/span><span style=\"color: rgb(0, 0, 0); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;\">will be anonymous and y<\/span><span style=\"color: rgb(34, 34, 34); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\">ou may discontinue your participation at any time without any negative consequences. <\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"color: rgb(34, 34, 34); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\">Please read each question carefully and select the best answer that indicates how you feel towards each question or statement by clicking your response. We ask that you read all items carefully and be honest about your feelings in your responses. <\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"color: rgb(34, 34, 34); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\">We are available to answer any questions or concerns you may have regarding this study at <\/span><span style=\"color: rgb(17, 85, 204); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: underline; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\"><a href=\"mailto:ladyresearchers@cpp.edu\">ladyresearchers@cpp.edu<\/a><\/span><span style=\"color: rgb(34, 34, 34); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\">. <\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"color: rgb(34, 34, 34); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\">Thank you in advance for your valuable time and participation. We appreciate your candid responses.<\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"color: rgb(34, 34, 34); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\">Kind Regards,<\/span><\/p><p><span style=\"color: rgb(34, 34, 34); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\"><br><\/span><\/p>\n\n<p><span style=\"color: rgb(0, 0, 0); font-family: Arial; font-size: 14.66px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;\">Lizbeth Huerta<\/span><\/p>\n\n<p><span style=\"color: rgb(0, 0, 0); font-family: Arial; font-size: 14.66px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;\">Sayaka Kuroda<\/span><\/p>\n\n<p><span style=\"color: rgb(0, 0, 0); font-family: Arial; font-size: 14.66px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;\">Rachel Reed<\/span><\/p>\n\n<p><span style=\"color: rgb(0, 0, 0); font-family: Arial; font-size: 14.66px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;\">Linda Sau<\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<div>&nbsp;<\/div>\n<strong>By selecting \"yes&nbsp;I would like to participate in this research\" on the below question, you are agreeing to that you have given your consent to take this survey, and that you are at least 18 years age.<\/strong>","DataExportTag":"Q1.1","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Study of Social Media Opinion Leader's Influence Dear Survey Participant, \u00a0 We are currently enro...","Choices":{"1":{"Display":"Yes, I would like to participate in this research."},"2":{"Display":"No, I do not want to participate in this research."}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"Language":[],"QuestionID":"QID1","GradingData":[],"QuestionText_Unsafe":"<p style=\"text-align: center;\"><span style=\"font-size: 16px;\"><strong>Study of Social Media Opinion Leader's Influence<\/strong><\/span><\/p><p style=\"text-align: center;\"><span style=\"font-size: 16px;\"><strong><br><\/strong><\/span><\/p>\n\n<p><span style=\"color: rgb(0, 0, 0); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;\">Dear Survey Participant, <\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"color: rgb(0, 0, 0); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;\">We are currently enrolled in the Market Research class at Cal Poly Pomona, and are conducting a research study as a part of our class requirement. <\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"color: rgb(34, 34, 34); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\">The purpose of the research is to understand how much of an impact opinion leaders on social media have on a consumer\u2019s purchase decisions. We want to hear your thoughts and opinions on this topic. The entire survey should take approximately 25 minutes of your time. This survey <\/span><span style=\"color: rgb(0, 0, 0); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;\">will be anonymous and y<\/span><span style=\"color: rgb(34, 34, 34); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\">ou may discontinue your participation at any time without any negative consequences. <\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"color: rgb(34, 34, 34); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\">Please read each question carefully and select the best answer that indicates how you feel towards each question or statement by clicking your response. We ask that you read all items carefully and be honest about your feelings in your responses. <\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"color: rgb(34, 34, 34); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\">We are available to answer any questions or concerns you may have regarding this study at <\/span><span style=\"color: rgb(17, 85, 204); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: underline; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\"><a href=\"mailto:ladyresearchers@cpp.edu\">ladyresearchers@cpp.edu<\/a><\/span><span style=\"color: rgb(34, 34, 34); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\">. <\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"color: rgb(34, 34, 34); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\">Thank you in advance for your valuable time and participation. We appreciate your candid responses.<\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<p><span style=\"color: rgb(34, 34, 34); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\">Kind Regards,<\/span><\/p><p><span style=\"color: rgb(34, 34, 34); font-family: Arial; font-size: 16px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: rgb(255, 255, 255);\"><br><\/span><\/p>\n\n<p><span style=\"color: rgb(0, 0, 0); font-family: Arial; font-size: 14.66px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;\">Lizbeth Huerta<\/span><\/p>\n\n<p><span style=\"color: rgb(0, 0, 0); font-family: Arial; font-size: 14.66px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;\">Sayaka Kuroda<\/span><\/p>\n\n<p><span style=\"color: rgb(0, 0, 0); font-family: Arial; font-size: 14.66px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;\">Rachel Reed<\/span><\/p>\n\n<p><span style=\"color: rgb(0, 0, 0); font-family: Arial; font-size: 14.66px; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;\">Linda Sau<\/span><\/p>\n\n<p>&nbsp;<\/p>\n\n<div>&nbsp;<\/div>\n<strong>By selecting \"yes&nbsp;I would like to participate in this research\" on the below question, you are agreeing to that you have given your consent to take this survey, and that you are at least 18 years age.<\/strong>"}},{"SurveyID":"SV_9EMz4vUv85Ya5cF","Element":"SQ","PrimaryAttribute":"QID54","SecondaryAttribute":"The amount of information about the Nike shoe in the video was __________________","TertiaryAttribute":null,"Payload":{"QuestionText":"The amount of information about the Nike shoe in the video was __________________","DefaultChoices":false,"DataExportTag":"Q7.2","QuestionType":"Matrix","Selector":"Bipolar","Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"MobileFirst":true},"QuestionDescription":"The amount of information about the Nike shoe in the video was __________________","Choices":{"1":{"Display":"Way too short:Way too much"},"2":{"Display":"Insufficient:Sufficient"},"3":{"Display":"Bad:Good"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceRe